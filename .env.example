DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-in-production-use-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://tmads:tmads@localhost:5432/tmads
REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# LOCAL | STAGING | PRODUCTION
APP_ENV=LOCAL

TELEGRAM_ADS_API_TOKEN=
TELEGRAM_ADS_WRITE_ENABLED=false
TELEGRAM_ADS_PAID_SUBMISSION_ENABLED=false
TELEGRAM_ADS_MEDIA_UPLOAD_ENABLED=false
TELEGRAM_ADS_RELATED_ACCOUNTS_ENABLED=false
TELEGRAM_ADS_WEBSITE_ENABLED=false
TELEGRAM_ADS_CUSTOMER_ASSETS_ENABLED=false

PAYMENT_GATEWAY=fake
PAYMENT_FAKE_ENABLED=true
# zarinpal — set PAYMENT_GATEWAY=zarinpal and merchant id for production sandbox/live
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

DEFAULT_EXCHANGE_RATE_TON_IRR=0
PLATFORM_SERVICE_FEE_PERCENT=5
TON_PRICING_RISK_BUFFER_PERCENT=2
QUOTE_VALIDITY_SECONDS=300
NOBITEX_STATS_SRC_CURRENCY=gram
NOBITEX_ORDERBOOK_SYMBOL=GRAMIRT

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
