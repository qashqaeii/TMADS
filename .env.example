DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-in-production-use-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://tmads:tmads@localhost:5432/tmads
REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# LOCAL | STAGING | PRODUCTION
APP_ENV=LOCAL
# Production only: canonical HTTPS origin, without a path or trailing query.
# Set in production after domain + HTTPS are configured:
# PUBLIC_SITE_URL=https://gramads.ir
PUBLIC_SITE_URL=

TELEGRAM_ADS_API_TOKEN=
TELEGRAM_ADS_WRITE_ENABLED=false
TELEGRAM_ADS_PAID_SUBMISSION_ENABLED=false
TELEGRAM_ADS_MEDIA_UPLOAD_ENABLED=false
TELEGRAM_ADS_RELATED_ACCOUNTS_ENABLED=false
TELEGRAM_ADS_WEBSITE_ENABLED=false
TELEGRAM_ADS_CUSTOMER_ASSETS_ENABLED=false

PAYMENT_GATEWAY=fake
PAYMENT_FAKE_ENABLED=true
# zarinpal — set PAYMENT_GATEWAY=zarinpal and merchant id for production sandbox/live
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
# Zibal: select PAYMENT_GATEWAY=zibal; use test merchant only outside production.
ZIBAL_MERCHANT_ID=

DEFAULT_EXCHANGE_RATE_TON_IRR=0
PLATFORM_SERVICE_FEE_PERCENT=5
TON_PRICING_RISK_BUFFER_PERCENT=2
QUOTE_VALIDITY_SECONDS=300
NOBITEX_STATS_SRC_CURRENCY=gram
NOBITEX_ORDERBOOK_SYMBOL=GRAMIRT

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Transactional SMS: enable only after TMADS patterns are approved.
SMS_ENABLED=false
SMS_PROVIDER=console
FARAZSMS_API_KEY=
FARAZSMS_LINE_NUMBER=
FARAZSMS_OTP_LINE_NUMBER=
FARAZSMS_OTP_ATTR=code
FARAZSMS_PATTERN_VERIFY_MOBILE=
FARAZSMS_PATTERN_WALLET_CREDIT=
FARAZSMS_PATTERN_BUDGET_LOW=
FARAZSMS_PATTERN_CAMPAIGN_STATUS=

# ArvanCloud AIaaS — paste the endpoint URL from the Arvan AIaaS panel (base /v1 or full /chat/completions URL).
# The key remains server-side and is never exposed to the browser.
ARVAN_AI_ENABLED=false
ARVAN_AI_BASE_URL=
ARVAN_AI_API_KEY=
ARVAN_AI_TIMEOUT_SECONDS=10
ARVAN_AI_MAX_RETRIES=1
ARVAN_AI_TEMPERATURE=0.2
ARVAN_AI_MAX_TOKENS=900
ARVAN_AI_USER_DAILY_LIMIT=10
ARVAN_AI_GLOBAL_DAILY_LIMIT=200
ARVAN_AI_PLANNER_DAILY_LIMIT=3
ARVAN_AI_CREATIVE_DAILY_LIMIT=4
ARVAN_AI_ANALYSIS_DAILY_LIMIT=3
ARVAN_AI_OPTIMIZATION_DAILY_LIMIT=3
